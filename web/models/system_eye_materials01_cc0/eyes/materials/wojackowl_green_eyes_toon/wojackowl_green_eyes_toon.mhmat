#This is a modified Eye Shader made by WojackOWL and it is under the CC0 License.


name Eye_green
description HighPolyEyes material
ambientColor 0.11 0.11 0.11
diffuseColor 1.0 1.0 1.0
specularColor 1.0 1.0 1.0
shininess 1.0
emissiveColor 0.0 0.0 0.0
opacity 1.0
translucency 0.0

shadeless True
wireframe False
transparent True
alphaToCoverage True
backfaceCull True
depthless False

castShadows True

receiveShadows True

diffuseTexture green_eye_toon.png

shader shaders/glsl/toon

shaderParam AdditiveShading 0.5
shaderParam litsphereTexture litspheres/skinmat_eye.png
shaderParam diffuseIntensity 1.0
shaderParam ambientIntensity 0.25

shaderConfig diffuse True
shaderConfig bump False
shaderConfig normal False
shaderConfig displacement False
shaderConfig spec False
shaderConfig vertexColors False
shaderConfig transparency True
shaderConfig ambientOcclusion True
